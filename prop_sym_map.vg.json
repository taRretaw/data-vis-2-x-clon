{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 400,
  "height": 500,
  "projection": {
    "type": "conicEqualArea",
    "rotate": [-147, 0, 0],
    "center": [0, -36],
    "parallels": [-18, -36],
    "scale": 1800
  },
  "layer": [
    {
      "data": {
        "url": "data/spatial_v2.json",
        "format": {"type": "topojson", "feature": "ne_50m_ocean"}
      },
      "mark": {"type": "geoshape", "fill": "#d4edf9"}
    },
    {
      "data": {
        "url": "data/spatial_v2.json",
        "format": {"type": "topojson", "feature": "ne_50m_admin_1_states_provinces"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eef2f5",
        "stroke": "#b0bec5",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/spatial_v2.json",
        "format": {"type": "topojson", "feature": "top_60"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#c8e6c9",
        "stroke": "#81c784",
        "strokeWidth": 0.5,
        "opacity": 0.6
      }
    },
    {
      "data": {
        "url": "data/spatial_v2.json",
        "format": {"type": "topojson", "feature": "top_60"}
      },
      "transform": [
        {
          "calculate": "geoCentroid(null, datum)[0]",
          "as": "centroid_lon"
        },
        {
          "calculate": "geoCentroid(null, datum)[1]",
          "as": "centroid_lat"
        },
        {
          "filter": "isValid(datum.properties.campsites_counts) && datum.properties.campsites_counts > 0"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#e65100",
        "opacity": 0.8,
        "stroke": "#ffffff",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {"field": "centroid_lon", "type": "quantitative"},
        "latitude": {"field": "centroid_lat", "type": "quantitative"},
        "size": {
          "field": "properties.campsites_counts",
          "type": "quantitative",
          "title": "Campsites",
          "scale": {"range": [0, 450]},

        "legend": {
            "title": "Campsites",
            "orient": "bottom-right",
            "direction": "vertical",
            "fillColor": "rgba(255,255,255,0.85)",
            "padding": 6,
            "titleFontSize": 11,
            "labelFontSize": 10
          }
        },
        "tooltip": [
          {"field": "properties.name", "type": "nominal", "title": "Park"},
          {"field": "properties.campsites_counts", "type": "quantitative", "title": "Campsites"}
        ]
      }
    }
  ]
}