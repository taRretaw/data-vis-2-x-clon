{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  
  "width": 400,
  "height": 500,
  "projection": {
    "type": "conicEqualArea",
    "rotate": [-147, 0, 0],
    "center": [0, -36],
    "parallels": [-18, -36],
    "scale": 1800
  },
  "layer": [
    {
      "data": {
        "url": "data/spatial_v2.json",
        "format": {"type": "topojson", "feature": "ne_50m_ocean"}
      },
      "mark": {"type": "geoshape", "fill": "#d4edf9"}
    },
    {
      "data": {
        "url": "data/spatial_v2.json",
        "format": {"type": "topojson", "feature": "ne_50m_admin_1_states_provinces"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eef2f5",
        "stroke": "#b0bec5",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/spatial_v2.json",
        "format": {"type": "topojson", "feature": "nat_park_makeup"}
      },
      "transform": [
        {
          "filter": "isValid(datum.properties.Reprojected_pc) && datum.properties.Reprojected_pc > 0"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#2e7d32",
        "strokeWidth": 0.0,
        "opacity": 0.85
      },
      "encoding": {
        "color": {
          "field": "properties.Reprojected_pc",
          "type": "quantitative",
          "title": "NP Coverage (%)",
          "scale": {
            "scheme": "greens"
          },
        "legend": {
            "orient": "bottom-right",
            "direction": "vertical",
            "fillColor": "rgba(255,255,255,0.85)",
            "padding": 3,
            "titleFontSize": 11,
            "labelFontSize": 10
          }
        },
        "tooltip": [
          {
            "field": "properties.Reprojected_pc",
            "type": "quantitative",
            "title": "Park Coverage (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ]
}