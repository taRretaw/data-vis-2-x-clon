{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 320,
  "data": {"url": "data/all_parks_stats.csv"},
  "transform": [
    {"filter": "isValid(datum.park_area) && datum.park_area >= 1000000 && isValid(datum.state)"},
    {"filter": {"field": "state", "oneOf": ["Victoria", "Tasmania", "New South Wales"]}},
    {"calculate": "datum.park_area / 1000000", "as": "area_km2"},
    {"calculate": "log(datum.area_km2) / log(10)", "as": "log_area"},
    {"bin": {"maxbins": 40}, "field": "log_area", "as": "bin_val"},
    {"stack": null, "groupby": ["state", "bin_val"], "as": ["stack_offset", "stack_end"], "offset": "center"}
  ],
  "mark": {"type": "circle", "size": 90, "opacity": 0.8, "stroke": "#ffffff", "strokeWidth": 1.5},
  "encoding": {
    "x": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "axis": {"labelAngle": 0, "labelFontSize": 13}
    },
    "xOffset": {"field": "stack_offset", "type": "quantitative"},
    "y": {
      "field": "area_km2",
      "type": "quantitative",
      "title": "Park area (km²)",
      "scale": {"type": "log"},
      "axis": {"grid": true, "format": ",", "values": [1, 10, 100, 1000, 5000]}
    },
    "color": {
      "field": "state",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": ["New South Wales", "Victoria", "Tasmania"],
        "range": ["#6a3d9a", "#e0a526", "#4fa3a5"]
      }
    },
    "tooltip": [
      {"field": "name", "type": "nominal", "title": "Park"},
      {"field": "state", "type": "nominal", "title": "State"},
      {"field": "area_km2", "type": "quantitative", "title": "Area (km²)", "format": ",.1f"},
      {"field": "walking_tracks_length", "type": "quantitative", "title": "Walking tracks (m)", "format": ","}
    ]
  }
}