{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 460,
  "height": 320,
  "padding": {"right": 10, "left": 5, "top": 10, "bottom": 5},
  "data": {
    "url": "data/all_parks_stats.csv"
  },
  "params": [
    {
      "name": "selected_park",
      "value": null,
      "bind": {
        "input": "select",
        "name": "Highlight a park: ",
        "options": [
          null,
          "Kosciuszko National Park",
          "Alpine National Park",
          "Grampians (Gariwerd) National Park",
          "Blue Mountains National Park",
          "Franklin-Gordon Wild Rivers National Park"
        ],
        "labels": [
          "All five parks",
          "Kosciuszko",
          "Alpine",
          "Grampians",
          "Blue Mountains",
          "Franklin-Gordon Wild Rivers"
        ]
      }
    }
  ],
  "transform": [
    {"filter": "indexof(['franklin-gordon wild rivers national park','grampians (gariwerd) national park','alpine national park','kosciuszko national park','blue mountains national park'], lower(datum.name)) >= 0"},
    {"filter": "isValid(datum.campsites_counts) && isValid(datum.toilet_count) && isValid(datum.lookouts_counts)"},
    {"calculate": "toNumber(datum.campsites_counts)", "as": "num_campsites"},
    {"calculate": "toNumber(datum.toilet_count)", "as": "num_toilets"},
    {"calculate": "toNumber(datum.lookouts_counts)", "as": "num_lookouts"},
    {"calculate": "replace(replace(datum.name, ' National Park', ''), ' (Gariwerd)', '')", "as": "short_name"},
    {
      "joinaggregate": [
        {"op": "max", "field": "num_campsites", "as": "max_camp"},
        {"op": "max", "field": "num_toilets", "as": "max_toilet"},
        {"op": "max", "field": "num_lookouts", "as": "max_lookout"}
      ]
    },
    {"calculate": "datum.max_camp > 0 ? (datum.num_campsites / datum.max_camp) * 100 : 0", "as": "Campsites"},
    {"calculate": "datum.max_toilet > 0 ? (datum.num_toilets / datum.max_toilet) * 100 : 0", "as": "Toilets"},
    {"calculate": "datum.max_lookout > 0 ? (datum.num_lookouts / datum.max_lookout) * 100 : 0", "as": "Lookouts"},
    {"fold": ["Campsites", "Toilets", "Lookouts"], "as": ["Metric", "Score"]},
    {"calculate": "datum.Metric === 'Campsites' ? datum.num_campsites : (datum.Metric === 'Toilets' ? datum.num_toilets : datum.num_lookouts)", "as": "raw_count"}
  ],
  "encoding": {
    "x": {
      "field": "Metric",
      "type": "nominal",
      "sort": ["Campsites", "Toilets", "Lookouts"],
      "title": null,
      "scale": {"range": [20, 360]},
      "axis": {"labelAngle": 0, "labelFontSize": 13, "labelFontWeight": 600, "grid": true, "domain": false, "ticks": false}
    },
    "y": {
      "field": "Score",
      "type": "quantitative",
      "title": "Relative to the highest of these five parks (%)",
      "scale": {"domain": [0, 100]}
    },
    "color": {"field": "state", "type": "nominal", "title": "State"}
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeJoin": "round"},
      "encoding": {
        "detail": {"field": "name", "type": "nominal"},
        "opacity": {
          "condition": {"test": "selected_park === null || datum.name === selected_park", "value": 1},
          "value": 0.15
        },
        "strokeWidth": {
          "condition": {"test": "selected_park !== null && datum.name === selected_park", "value": 5},
          "value": 3
        }
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 70},
      "encoding": {
        "opacity": {
          "condition": {"test": "selected_park === null || datum.name === selected_park", "value": 1},
          "value": 0.15
        },
        "tooltip": [
          {"field": "name", "type": "nominal", "title": "Park"},
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "Metric", "type": "nominal", "title": "Feature"},
          {"field": "raw_count", "type": "quantitative", "title": "Mapped count"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.Metric === 'Lookouts'"}],
      "mark": {"type": "text", "align": "left", "dx": 10, "fontSize": 12, "fontWeight": 600},
      "encoding": {
        "text": {"field": "short_name", "type": "nominal"},
        "opacity": {
          "condition": {"test": "selected_park === null || datum.name === selected_park", "value": 1},
          "value": 0.25
        }
      }
    },
    {
      "mark": {"type": "text", "dy": -13, "fontSize": 12, "fontWeight": 700},
      "encoding": {
        "text": {"field": "raw_count", "type": "quantitative", "format": ","},
        "color": {"value": "#263238"},
        "opacity": {
          "condition": {"test": "selected_park !== null && datum.name === selected_park", "value": 1},
          "value": 0
        }
      }
    }
  ]
}