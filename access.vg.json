{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Tourist Accessibility Profiles (Top 10 Parks)",
    "subtitle": "Comparing normalized facility counts (0 - 100% scale) across key visitor amenities",
    "fontSize": 16,
    "anchor": "start",
    "offset": 15
  },
  "width": 500,
  "height": 320,
  "data": {
    "url": "https://raw.githubusercontent.com/taRretaw/data-vis-2-x-clon/refs/heads/main/data/all_park_stats.csv"
  },
  "params": [
    {
      "name": "selected_park",
      "value": null,
      "bind": {
        "input": "select",
        "options": [
          null,
          "Kosciuszko National Park",
          "Grampians National Park",
          "Wilsons Promontory National Park",
          "Alpine National Park",
          "Barrington Tops National Park",
          "Blue Mountains National Park",
          "Cradle Mountain-Lake St Clair National Park",
          "Freycinet National Park",
          "Mount Buffalo National Park",
          "Morton National Park"
        ],
        "labels": [
          "All Parks Highlighted",
          "Kosciuszko",
          "Grampians",
          "Wilsons Promontory",
          "Alpine",
          "Barrington Tops",
          "Blue Mountains",
          "Cradle Mountain",
          "Freycinet",
          "Mount Buffalo",
          "Morton"
        ],
        "name": "Select Park: "
      }
    }
  ],
  "transform": [
    {
      "filter": "isValid(datum.campsites_counts) && isValid(datum.toilet_count) && isValid(datum.lookouts_counts) && isValid(datum.waterfalls_counts)"
    },
    {"calculate": "toNumber(datum.campsites_counts)", "as": "num_campsites"},
    {"calculate": "toNumber(datum.toilet_count)", "as": "num_toilets"},
    {"calculate": "toNumber(datum.lookouts_counts)", "as": "num_lookouts"},
    {"calculate": "toNumber(datum.waterfalls_counts)", "as": "num_waterfalls"},
    {
      "calculate": "datum.num_campsites + datum.num_toilets + datum.num_lookouts + datum.num_waterfalls",
      "as": "total_fac"
    },
    {
      "window": [{"op": "rank", "as": "rank"}],
      "sort": [{"field": "total_fac", "order": "descending"}]
    },
    {
      "filter": "datum.rank <= 10"
    },
    {
      "joinaggregate": [
        {"op": "max", "field": "num_campsites", "as": "max_camp"},
        {"op": "max", "field": "num_toilets", "as": "max_toilet"},
        {"op": "max", "field": "num_lookouts", "as": "max_lookout"},
        {"op": "max", "field": "num_waterfalls", "as": "max_waterfall"}
      ]
    },
    {
      "calculate": "datum.max_camp > 0 ? (datum.num_campsites / datum.max_camp) * 100 : 0",
      "as": "Campsites"
    },
    {
      "calculate": "datum.max_toilet > 0 ? (datum.num_toilets / datum.max_toilet) * 100 : 0",
      "as": "Toilets"
    },
    {
      "calculate": "datum.max_lookout > 0 ? (datum.num_lookouts / datum.max_lookout) * 100 : 0",
      "as": "Lookouts"
    },
    {
      "calculate": "datum.max_waterfall > 0 ? (datum.num_waterfalls / datum.max_waterfall) * 100 : 0",
      "as": "Waterfalls"
    },
    {
      "fold": ["Campsites", "Toilets", "Lookouts", "Waterfalls"],
      "as": ["Metric", "NormalizedScore"]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "clip": true
      },
      "encoding": {
        "x": {
          "field": "Metric",
          "type": "nominal",
          "title": "Facility Category",
          "scale": {"padding": 0.2},
          "axis": {"labelAngle": 0}
        },
        "y": {
          "field": "NormalizedScore",
          "type": "quantitative",
          "title": "Normalized Relative Score (%)",
          "scale": {"domain": [0, 100], "clamp": true}
        },
        "detail": {"field": "name", "type": "nominal"},
        "color": {
          "condition": {
            "test": "selected_park === null || datum.name === selected_park",
            "field": "name",
            "type": "nominal",
            "title": "Park"
          },
          "value": "#cfd8dc"
        },
        "opacity": {
          "condition": {
            "test": "selected_park === null || datum.name === selected_park",
            "value": 1
          },
          "value": 0.15
        },
        "strokeWidth": {
          "condition": {
            "test": "selected_park !== null && datum.name === selected_park",
            "value": 4.5
          },
          "value": 2
        },
        "tooltip": [
          {"field": "name", "type": "nominal", "title": "Park"},
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "Metric", "type": "nominal", "title": "Category"},
          {
            "field": "NormalizedScore",
            "type": "quantitative",
            "title": "Relative Score (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 50,
        "clip": true
      },
      "encoding": {
        "x": {"field": "Metric", "type": "nominal"},
        "y": {
          "field": "NormalizedScore",
          "type": "quantitative",
          "scale": {"domain": [0, 100], "clamp": true}
        },
        "detail": {"field": "name", "type": "nominal"},
        "color": {
          "condition": {
            "test": "selected_park === null || datum.name === selected_park",
            "field": "name",
            "type": "nominal"
          },
          "value": "#b0bec5"
        },
        "opacity": {
          "condition": {
            "test": "selected_park === null || datum.name === selected_park",
            "value": 1
          },
          "value": 0.2
        }
      }
    }
  ]
}