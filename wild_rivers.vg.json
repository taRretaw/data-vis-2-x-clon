{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 640,
  "height": 640,
  "background": "transparent",
  "config": {"view": {"stroke": null}},
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {
        "url": "data/wild_rivers_v2.json",
        "format": {"type": "topojson", "feature": "wild_elev_polygons"}
      },
      "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 0.0},
      "encoding": {
        "color": {
          "field": "properties.ELEV_MAX",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [200, 400, 600, 800, 1000, 1200, 1500, 1800, 2000],
            "range": ["#b7cf9f", "#d3dfa2", "#ebe3a6", "#e6cf94", "#d4b07a",
                      "#b88a63", "#9a7058", "#8a7f7a", "#bdb8b3", "#f1efec"]
          },
          "legend": {"title": "Elevation (m)", "orient": "top-left"}
        }
      }
    },
    {
    "data": {
        "url": "data/wild_rivers_v2.json",
        "format": {"type": "topojson", "feature": "streams"}
    },
    "mark": {"type": "geoshape", "filled": false, "stroke": "#5fa8d3", "strokeWidth": 1.2, "strokeCap": "round", "strokeJoin": "round", "opacity": 0.8}
    },
    {
    "data": {
        "url": "data/wild_rivers_v2.json",
        "format": {"type": "topojson", "feature": "streams_ah"}
    },
    "transform": [
        {"calculate": "toNumber(datum.properties.angle)", "as": "flow_angle"}
    ],
    "mark": {
        "type": "point",
        "shape": "M0,-1L0.5,1L-0.5,1Z",
        "filled": true,
        "color": "#5fa8d3",
        "size": 100
        },
    "encoding": {
        "longitude": {"field": "geometry.coordinates[0]", "type": "quantitative"},
        "latitude": {"field": "geometry.coordinates[1]", "type": "quantitative"},
        "angle": {"field": "flow_angle", "type": "quantitative", "scale": null}
    }
    },
    {
    "data": {
        "url": "data/wild_rivers_v2.json",
        "format": {"type": "topojson", "feature": "major_rivers"}
    },
    "mark": {"type": "geoshape", "filled": false, "stroke": "#5281b6", "strokeWidth": 2.5, "strokeCap": "round", "strokeJoin": "round"}
    },
    {
    "data": {
        "url": "data/wild_rivers_v2.json",
        "format": {"type": "topojson", "feature": "rivers_ah"}
    },
    "transform": [
        {"calculate": "toNumber(datum.properties.angle)", "as": "flow_angle"}
    ],
    "mark": {"type": "point", "shape": "triangle-up", "filled": true, "color": "#0d47a1", "size": 100, "opacity": 1},
    "encoding": {
        "longitude": {"field": "geometry.coordinates[0]", "type": "quantitative"},
        "latitude": {"field": "geometry.coordinates[1]", "type": "quantitative"},
        "angle": {"field": "flow_angle", "type": "quantitative", "scale": null}
    }
    },
    {
    "data": {
        "url": "data/wild_rivers_v2.json",
        "format": {"type": "topojson", "feature": "fwd"}
    },
    "mark": {"type": "geoshape", "filled": false, "stroke": "#c62828", "strokeWidth": 1, "strokeDash": [4, 3], "opacity": 0.7}
    },
    {
    "data": {
        "url": "data/wild_rivers_v2.json",
        "format": {"type": "topojson", "feature": "trails"}
    },
    "mark": {"type": "geoshape", "filled": false, "stroke": "#c62828", "strokeWidth": 1.4, "opacity": 0.7}
    },
    {
    "data": {
        "values": {
        "type": "FeatureCollection",
        "features": [
            {
            "type": "Feature",
            "geometry": {
                "type": "LineString",
                "coordinates": [[145.40, -42.845], [145.645, -42.845]]
            }
            }
        ]
        },
        "format": {"type": "json", "property": "features"}
    },
    "mark": {"type": "geoshape", "filled": false, "stroke": "#263238", "strokeWidth": 3}
    },
    {
    "data": {"values": [{"lon": 145.523, "lat": -42.845}]},
    "mark": {"type": "text", "text": "20 km", "dy": -15, "fontSize": 15, "fontWeight": 600, "color": "#263238"},
    "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"}
    }
    }
    
  ]
}