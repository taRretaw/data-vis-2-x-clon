{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 350,
  "data": {
    "url": "data/all_parks_stats.csv",
    "format": {"type": "csv", "parse": {"elevation_m_max": "number"}}
  },
  "transform": [
    {"filter": "isValid(datum.elevation_m_max) && datum.elevation_m_max > 0"},
    {"filter": "indexof(['franklin-gordon wild rivers national park','grampians (gariwerd) national park','alpine national park','kosciuszko national park','blue mountains national park'], lower(datum.name)) >= 0"},
    {"calculate": "indexof(['kosciuszko national park','blue mountains national park'], lower(datum.name)) >= 0 ? 'New South Wales' : (indexof(['alpine national park','grampians (gariwerd) national park'], lower(datum.name)) >= 0 ? 'Victoria' : 'Tasmania')", "as": "state_fixed"},
    {"calculate": "replace(replace(datum.name, ' National Park', ''), ' (Gariwerd)', '')", "as": "short_name"}
  ],
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 3},
      "encoding": {
        "x": {"field": "name", "type": "nominal", "sort": "-y", "title": null, "axis": null},
        "y": {"field": "elevation_m_max", "type": "quantitative", "title": "Highest peak (m above sea level)"},
        "y2": {"datum": 0},
        "color": {
          "field": "state_fixed",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": ["New South Wales", "Victoria", "Tasmania"],
            "range": ["#6a3d9a", "#e0a526", "#4fa3a5"]
          }
        }
      }
    },
    {
      "mark": {"type": "circle", "size": 160, "stroke": "#37474f", "strokeWidth": 1},
      "encoding": {
        "x": {"field": "name", "type": "nominal", "sort": "-y"},
        "y": {"field": "elevation_m_max", "type": "quantitative"},
        "color": {
          "field": "state_fixed",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": ["New South Wales", "Victoria", "Tasmania"],
            "range": ["#6a3d9a", "#e0a526", "#4fa3a5"]
          }
        },
        "tooltip": [
          {"field": "name", "type": "nominal", "title": "Park"},
          {"field": "state_fixed", "type": "nominal", "title": "State"},
          {"field": "elevation_m_max", "type": "quantitative", "title": "Highest peak (m)", "format": ","},
          {"field": "peaks_counts", "type": "quantitative", "title": "Mapped peaks"}
        ]
      }
    },
    {
      "mark": {"type": "text", "baseline": "bottom", "dy": -12, "fontSize": 12, "fontWeight": 600, "color": "#263238"},
      "encoding": {
        "x": {"field": "name", "type": "nominal", "sort": "-y"},
        "y": {"field": "elevation_m_max", "type": "quantitative"},
        "text": {"field": "short_name", "type": "nominal"}
      }
    }
  ]
}